# Add this as a RunPod secret/environment variable. Never commit the real value.
WANDB_API_KEY=
WANDB_PROJECT=cftn-text-v2
WANDB_GROUP=broad-math-400k

# Persistent RunPod volume locations.
CFTN_DATA_ROOT=/workspace/volume/cftn-text/data/v2_broad_math_400k
CFTN_ARTIFACT_ROOT=/workspace/volume/cftn-text/artifacts/v2_broad_math_400k
CFTN_V1_2_REPORT=/workspace/cftn-text/evidence/v1_2_final_report.json
CFTN_V1_3_REPORT=/workspace/volume/cftn-text/evidence/v1_3_final_report.json
HF_HOME=/workspace/volume/cftn-text/cache/huggingface
