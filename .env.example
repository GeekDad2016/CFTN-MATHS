# Add this as a RunPod secret/environment variable. Never commit the real value.
WANDB_API_KEY=
WANDB_PROJECT=cftn-text-v2
WANDB_GROUP=broad-math-400k
# Optional. Leave empty to use the default entity attached to WANDB_API_KEY.
WANDB_ENTITY=
WANDB_DIR=/workspace/volume/cftn-text/artifacts/v2_broad_math_400k_r2/wandb

# Generate a random value with at least 32 characters and store it as a RunPod
# secret. The read/write API never accepts this token in a URL or config file.
CFTN_CONTROL_API_TOKEN=
CFTN_CONTROL_PORT=8000
# Fail-closed by default. Set to 1 only when fast-forward Git updates are wanted.
CFTN_CONTROL_ALLOW_UPDATES=0

# Persistent RunPod volume locations.
CFTN_REPOSITORY_ROOT=/workspace/volume/cftn-text/repository
CFTN_GIT_REPOSITORY=https://github.com/GeekDad2016/CFTN-MATHS.git
CFTN_GIT_BRANCH=main
CFTN_GIT_ALLOWED_REMOTE=https://github.com/GeekDad2016/CFTN-MATHS.git
CFTN_DATA_ROOT=/workspace/volume/cftn-text/data/v2_broad_math_400k_r2
CFTN_ARTIFACT_ROOT=/workspace/volume/cftn-text/artifacts/v2_broad_math_400k_r2
CFTN_V1_2_REPORT=/workspace/volume/cftn-text/repository/evidence/v1_2_final_report.json
CFTN_V1_3_REPORT=/workspace/volume/cftn-text/evidence/v1_3_final_report.json
HF_HOME=/workspace/volume/cftn-text/cache/huggingface

# Set these only on the trusted machine running tools.runpod_remote, not on the pod.
CFTN_REMOTE_API_URL=
CFTN_REMOTE_API_TOKEN=
