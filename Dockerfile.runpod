ARG PYTORCH_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
FROM ${PYTORCH_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false

WORKDIR /workspace/cftn-text
COPY . /workspace/cftn-text
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --upgrade pip && python -m pip install -e .
RUN chmod +x /workspace/cftn-text/scripts/runpod_entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/workspace/cftn-text/scripts/runpod_entrypoint.sh"]
